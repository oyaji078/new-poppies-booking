APP_NAME="New Poppies Senggigi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=new_poppies_booking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="reservasi@newpoppiessenggigi.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# DOKU Checkout (sandbox by default). Never commit real credentials.
#
# Credentials: dashboard DOKU -> Integration -> Credentials. Sandbox credentials
# only work against the sandbox host and vice versa; mixing them returns
# "invalid_client_id". Verify with:  php artisan doku:check --ping
#
# DOKU_NOTIFICATION_URL must be reachable FROM THE INTERNET (DOKU calls it), and
# its path is what the notification signature is computed over — keep the path
# exactly /api/payments/doku/notifications. Locally: ngrok http 8000, then set
# APP_URL to the ngrok URL and register the same URL in the DOKU dashboard.
#
# DOKU_PAYMENT_DUE_MINUTES must be <= the booking hold (Admin -> Pengaturan),
# otherwise the payment page outlives the room reservation.
# ---------------------------------------------------------------------------
# Both environments live side by side. Which one is active is stored in
# system_settings and switched by a Super Admin at /admin/doku — credentials
# never enter the database. DOKU_ENVIRONMENT is only the boot-time default.
DOKU_ENVIRONMENT=sandbox

DOKU_SANDBOX_CLIENT_ID=
DOKU_SANDBOX_SECRET_KEY=
DOKU_SANDBOX_BASE_URL=https://api-sandbox.doku.com

DOKU_PRODUCTION_CLIENT_ID=
DOKU_PRODUCTION_SECRET_KEY=
DOKU_PRODUCTION_BASE_URL=https://api.doku.com

# Payment methods on the DOKU page (comma-separated). Empty = show all methods
# enabled on the account. A single method sends the guest straight to it.
DOKU_PAYMENT_METHODS=QRIS

DOKU_NOTIFICATION_URL="${APP_URL}/api/payments/doku/notifications"
DOKU_CALLBACK_URL="${APP_URL}/payment/callback"
DOKU_PAYMENT_DUE_MINUTES=30
DOKU_HTTP_TIMEOUT=30

# ---------------------------------------------------------------------------
# Hotel policy (currency only).
#
# Hold duration, max nights, check-in/out times, tax and service percentages are
# NOT environment variables — they live in the system_settings table so staff can
# change them from Admin -> Pengaturan without a deploy. Seeded by SettingsSeeder.
# ---------------------------------------------------------------------------
HOTEL_CURRENCY=IDR
